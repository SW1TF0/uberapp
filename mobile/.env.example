# Client-side key for Places Autocomplete, Directions, and Distance Matrix
# REST calls made directly from the app. Restrict it in Google Cloud Console
# by Android package name / iOS bundle ID, and enable: Places API,
# Directions API, Distance Matrix API.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Separate key used by the native Google Maps SDK on Android — set the same
# value directly in mobile/app.json under android.config.googleMaps.apiKey
# (Expo config plugins don't read .env at build time for that field).
