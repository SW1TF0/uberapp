{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && auth.token.email === 'krasimiruzun@smartmenukj.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'krasimiruzun@smartmenukj.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'krasimiruzun@smartmenukj.com')",
        ".validate": "newData.hasChildren(['uid','role','name','phone','email','createdAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'rider' || newData.val() === 'driver')"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 80"
        },
        "phone": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "avatarUrl": {
          ".validate": "newData.isString() && newData.val().length < 150000"
        },
        "notificationsEnabled": {
          ".validate": "newData.isBoolean()"
        },
        "banned": {
          ".validate": "newData.isBoolean() && (newData.val() === data.val() || auth.token.email === 'krasimiruzun@smartmenukj.com')"
        },
        "consent": {
          ".validate": "newData.hasChildren(['termsAcceptedAt','privacyAcceptedAt','version'])",
          "termsAcceptedAt": { ".validate": "newData.isNumber()" },
          "privacyAcceptedAt": { ".validate": "newData.isNumber()" },
          "version": { ".validate": "newData.isString()" }
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "drivers": {
      ".read": "auth != null",
      ".indexOn": ["status"],
      "$driverId": {
        "profile": {
          ".write": "auth != null && auth.uid === $driverId",
          ".validate": "newData.hasChildren(['name','phone','rating','vehicle'])",
          "rating": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          },
          "vehicle": {
            ".validate": "newData.hasChildren(['make','model','color','plate','type'])",
            "type": {
              ".validate": "newData.isString() && (newData.val() === 'economy' || newData.val() === 'comfort' || newData.val() === 'xl')"
            }
          },
          "avatarUrl": {
            ".validate": "newData.isString() && newData.val().length < 150000"
          },
          "carPhotoUrl": {
            ".validate": "newData.isString() && newData.val().length < 150000"
          }
        },

        "approved": {
          ".write": "auth != null && (auth.uid === $driverId || auth.token.email === 'krasimiruzun@smartmenukj.com')",
          ".validate": "newData.isBoolean() && ((!data.exists() && newData.val() === false) || newData.val() === data.val() || auth.token.email === 'krasimiruzun@smartmenukj.com')"
        },

        "status": {
          ".write": "auth != null && auth.uid === $driverId",
          ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline' || newData.val() === 'busy') && (newData.val() !== 'online' || (root.child('users').child($driverId).child('banned').val() !== true && root.child('drivers').child($driverId).child('approved').val() === true))"
        },

        "location": {
          ".write": "auth != null && auth.uid === $driverId",
          ".validate": "newData.hasChildren(['lat','lng','updatedAt'])",
          "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "heading": { ".validate": "newData.isNumber() || newData.val() === null" },
          "speed": { ".validate": "newData.isNumber() || newData.val() === null" },
          "updatedAt": { ".validate": "newData.isNumber()" }
        },

        "settledUpTo": {
          ".write": "auth != null && auth.token.email === 'krasimiruzun@smartmenukj.com'",
          ".validate": "newData.isNumber()"
        },

        "compliance": {
          ".write": "auth != null && auth.uid === $driverId",
          "licenseNumber": { ".validate": "newData.isString() && newData.val().length < 60" },
          "insurancePolicyNumber": { ".validate": "newData.isString() && newData.val().length < 60" },
          "insuranceExpiresAt": { ".validate": "newData.isNumber()" },
          "licenseDocUrl": { ".validate": "newData.isString() && newData.val().length < 150000" },
          "insuranceDocUrl": { ".validate": "newData.isString() && newData.val().length < 150000" }
        }
      }
    },

    "driverRequests": {
      "$driverId": {
        ".read": "auth != null && auth.uid === $driverId",
        ".write": "auth != null && auth.uid === $driverId",
        "$rideId": {
          ".write": "auth != null && (auth.uid === $driverId || root.child('rides').child($rideId).child('riderId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['rideId','offeredAt','expiresAt','pickupDistanceKm','fareEstimateBGN'])"
        }
      }
    },

    "rides": {
      ".indexOn": ["riderId", "driverId", "status"],
      "$rideId": {
        ".read": "auth != null && (data.child('riderId').val() === auth.uid || data.child('driverId').val() === auth.uid || auth.token.email === 'krasimiruzun@smartmenukj.com')",
        ".write": "auth != null && ((!data.exists() && newData.child('riderId').val() === auth.uid && newData.child('status').val() === 'requested' && root.child('users').child(auth.uid).child('banned').val() !== true) || (data.exists() && data.child('riderId').val() === auth.uid && (newData.child('status').val() === 'cancelled' || data.child('status').val() === newData.child('status').val())) || (data.exists() && data.child('driverId').val() === auth.uid) || (data.exists() && data.child('status').val() === 'requested' && data.child('driverId').val() === null && newData.child('driverId').val() === auth.uid && newData.child('status').val() === 'accepted' && root.child('drivers').child(auth.uid).child('status').val() === 'online' && root.child('users').child(auth.uid).child('banned').val() !== true))",

        "riderId": { ".validate": "newData.isString()" },
        "driverId": { ".validate": "newData.val() === null || newData.isString()" },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'requested' || newData.val() === 'accepted' || newData.val() === 'arrived' || newData.val() === 'in_progress' || newData.val() === 'completed' || newData.val() === 'cancelled')"
        },
        "pickup": { ".validate": "newData.hasChildren(['lat','lng'])" },
        "dropoff": { ".validate": "newData.hasChildren(['lat','lng'])" },
        "vehicleType": {
          ".validate": "newData.isString() && (newData.val() === 'economy' || newData.val() === 'comfort' || newData.val() === 'xl')"
        },
        "paymentMethod": {
          ".validate": "newData.isString() && (newData.val() === 'cash' || newData.val() === 'card')"
        },
        "fareEstimateBGN": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "finalFareBGN": { ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 0)" },

        "paymentStatus": { ".validate": "newData.val() === data.val()" },
        "stripePaymentIntentId": { ".validate": "newData.val() === data.val()" },

        "matching": {
          ".write": "auth != null && (root.child('rides').child($rideId).child('riderId').val() === auth.uid || data.child('offeredDriverId').val() === auth.uid)"
        }
      }
    },

    "activeRides": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === null || newData.isString()"
      }
    },

    "pricing_rules": {
      ".read": "auth != null",
      ".write": false
    },

    "transactions": {
      "$rideId": {
        ".read": "auth != null && (data.child('riderId').val() === auth.uid || data.child('driverId').val() === auth.uid)",
        ".write": "auth != null && root.child('rides').child($rideId).child('driverId').val() === auth.uid && root.child('rides').child($rideId).child('status').val() === 'completed'"
      }
    },

    "riderHistory": {
      "$riderId": {
        ".read": "auth != null && auth.uid === $riderId",
        "$rideId": {
          ".write": "auth != null && root.child('rides').child($rideId).child('driverId').val() === auth.uid"
        }
      }
    },

    "driverHistory": {
      "$driverId": {
        ".read": "auth != null && (auth.uid === $driverId || auth.token.email === 'krasimiruzun@smartmenukj.com')",
        "$rideId": {
          ".write": "auth != null && auth.uid === $driverId"
        }
      }
    },

    "reports": {
      ".read": "auth != null && auth.token.email === 'krasimiruzun@smartmenukj.com'",
      "$reportId": {
        ".write": "auth != null && !data.exists() && newData.child('reporterId').val() === auth.uid",
        ".validate": "newData.hasChildren(['reporterId','reporterRole','reportedId','reason','createdAt'])",
        "reporterId": { ".validate": "newData.isString()" },
        "reporterRole": { ".validate": "newData.isString() && (newData.val() === 'rider' || newData.val() === 'driver')" },
        "reportedId": { ".validate": "newData.isString()" },
        "rideId": { ".validate": "newData.val() === null || newData.isString()" },
        "reason": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 1000" },
        "createdAt": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
